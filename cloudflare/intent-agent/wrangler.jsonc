{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "asympta-public-intent-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "DAILY_GLOBAL_BUDGET": "500",
    "OPENROUTER_MODEL": "minimax/minimax-m3:free"
  },
  "ratelimits": [
    {
      "name": "INTENT_RATE_LIMIT",
      "namespace_id": "2026083001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_DAILY_BUDGET",
        "class_name": "DailyGlobalBudget"
      }
    ]
  },
  "exports": {
    "DailyGlobalBudget": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  }
}
