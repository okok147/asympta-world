.aw-active-need { display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 7px; }
.aw-scenarios > span { margin-right: 2px; color: var(--aw-ink-faint); font-size: .49rem; }
.aw-scenarios button { display: inline-flex; align-items: center; gap: 4px; min-height: 29px; padding: 5px 8px; border: 1px solid var(--aw-line); border-radius: 999px; background: rgba(247,246,240,.72); color: var(--aw-ink-soft); font-size: .5rem; backdrop-filter: blur(10px); }
.aw-scenarios button.is-featured { border-color: rgba(80,105,92,.28); background: rgba(112,135,122,.11); color: var(--aw-sage-deep); }
.aw-active-need { justify-content: space-between; padding: 0 4px; }
.aw-active-need > span { display: inline-flex; align-items: center; gap: 6px; color: var(--aw-ink-soft); font-size: .5rem; }
.aw-active-need > span i { width: 5px; height: 5px; border-radius: 50%; background: var(--aw-sage); }
.aw-active-need button { display: inline-flex; align-items: center; gap: 4px; border: 0; background: transparent; color: var(--aw-ink-faint); font-size: .48rem; }

.aw-composer__form { display: grid; grid-template-columns: 1fr auto; gap: 6px; padding: 6px; border: 1px solid rgba(69,75,70,.2); border-radius: 17px; background: rgba(250,249,244,.93); box-shadow: 0 16px 48px rgba(43,43,43,.1); backdrop-filter: blur(24px); }
.aw-composer__form input { min-width: 0; height: 40px; padding: 0 10px; border: 0; background: transparent; color: var(--aw-ink); font-size: .69rem; outline: 0; }
.aw-composer__form input::placeholder { color: var(--aw-ink-faint); }
.aw-composer__form button { display: inline-flex; align-items: center; justify-content: center; gap: 5px; min-width: 80px; height: 40px; padding: 0 13px; border: 0; border-radius: 12px; background: var(--aw-ink); color: #f8f7f2; font-size: .61rem; }
.aw-composer__form button:disabled { opacity: .24; }
.aw-composer footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 5px 8px 0; color: var(--aw-ink-faint); font-size: .41rem; }
.aw-composer footer span:first-child { display: inline-flex; align-items: center; gap: 4px; }

.aw-command-menu { position: absolute; left: 0; right: 0; bottom: 62px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; padding: 6px; border: 1px solid var(--aw-line); border-radius: 16px; background: rgba(247,246,240,.97); box-shadow: var(--aw-shadow); backdrop-filter: blur(22px); }
.aw-command-menu button { display: flex; align-items: center; justify-content: space-between; padding: 9px 10px; border: 0; border-radius: 10px; background: transparent; color: var(--aw-ink-soft); text-align: left; }
.aw-command-menu button:hover { background: rgba(112,135,122,.08); color: var(--aw-ink); }
.aw-command-menu strong,
.aw-command-menu small { display: block; }
.aw-command-menu strong { font-size: .58rem; }
.aw-command-menu small { margin-top: 2px; color: var(--aw-ink-faint); font-family: var(--aw-mono); font-size: .42rem; }

.aw-approval-backdrop { position: fixed; z-index: 200; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(43,43,43,.18); backdrop-filter: blur(8px); }
.aw-approval { width: min(430px, 100%); padding: 24px; border: 1px solid rgba(255,255,255,.5); border-radius: 24px; background: var(--aw-paper-clear); box-shadow: 0 30px 90px rgba(43,43,43,.2); text-align: center; }
.aw-approval__icon { display: grid; place-items: center; width: 46px; height: 46px; margin: 0 auto 10px; border: 1px solid rgba(80,105,92,.24); border-radius: 50%; background: rgba(112,135,122,.09); color: var(--aw-sage-deep); }
.aw-approval > small { color: var(--aw-sage-deep); font-family: var(--aw-mono); font-size: .48rem; letter-spacing: .11em; }
.aw-approval h2 { margin: 8px 0 6px; font-size: 1.2rem; font-weight: 610; letter-spacing: -.02em; }
.aw-approval p { margin: 0 auto; max-width: 370px; color: var(--aw-ink-soft); font-size: .67rem; line-height: 1.6; }
.aw-approval__actions { display: grid; grid-template-columns: 1fr 1.25fr; gap: 7px; margin-top: 18px; }
.aw-approval__actions button { min-height: 40px; border: 1px solid var(--aw-line); border-radius: 12px; background: transparent; color: var(--aw-ink-soft); font-size: .59rem; }
.aw-approval__actions button.is-primary { display: inline-flex; align-items: center; justify-content: center; gap: 5px; border-color: var(--aw-ink); background: var(--aw-ink); color: var(--aw-paper-clear); }

@keyframes aw-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
@keyframes aw-work { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-2px) rotate(1deg); } }

@media (max-width: 1180px) {
  .aw-header { grid-template-columns: minmax(200px,1fr) auto auto; }
  .aw-journey { width: calc(100vw - 40px); }
  .aw-journey__item small { display: none; }
  .aw-result { width: 290px; }
}

@media (max-width: 900px) {
  .aw-header { grid-template-columns: 1fr auto; }
  .aw-location { display: none; }
  .aw-thesis { top: 69px; max-width: calc(100vw - 30px); overflow: hidden; text-overflow: ellipsis; }
  .aw-thesis span:last-child { display: none; }
  .aw-journey { top: 94px; width: calc(100vw - 24px); min-height: 42px; overflow-x: auto; scrollbar-width: none; }
  .aw-journey::-webkit-scrollbar { display: none; }
  .aw-journey__item { min-width: 85px; padding: 6px 7px; }
  .aw-stage-wrap { inset: 143px 0 116px; }
  .aw-world { left: 10px; right: 10px; border-radius: 22px; }
  .aw-result { left: 22px; top: 12px; width: min(290px, calc(100vw - 44px)); }
  .aw-inspector { right: 22px; width: min(250px, calc(100vw - 44px)); }
  .aw-agent__thought { display: none; }
  .aw-service { display: none; }
  .aw-world__empty { width: 72vw; }
}

@media (max-width: 720px) {
  .aw-shell { min-height: 480px; }
  .aw-header { min-height: 58px; padding-left: max(10px, env(safe-area-inset-left)); padding-right: max(10px, env(safe-area-inset-right)); }
  .aw-brand small { display: none; }
  .aw-webmcp { padding: 6px; }
  .aw-webmcp small { display: none; }
  .aw-thesis { top: 62px; font-size: .54rem; }
  .aw-journey { top: 84px; width: calc(100vw - 16px); }
  .aw-stage-wrap { inset: 133px 0 119px; }
  .aw-world { inset: 0 7px; border-radius: 18px; }
  .aw-zone > span:last-child small { display: none; }
  .aw-zone strong { font-size: .47rem; }
  .aw-human__need { left: 0; width: 190px; }
  .aw-agent__name small { display: none; }
  .aw-message { display: none; }
