{
  "name": "asympta-world",
  "version": "0.1.0",
  "private": true,
  "description": "A living WebMCP world where specialised agents coordinate everyday human needs with visible tools and approval.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okok147/asympta-world.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:pages": "ASYMPTA_PAGES_BUILD=1 bash scripts/build-verified.sh",
    "export:pages": "npm run build:pages && ASYMPTA_PAGES_BUILD=1 node --experimental-loader ./scripts/cloudflare-node-loader.mjs scripts/export-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log NODE_OPTIONS='--experimental-loader ./scripts/cloudflare-node-loader.mjs' vinext start",
    "test": "npm run build && npm run test:all",
    "test:all": "node --experimental-loader ./scripts/cloudflare-node-loader.mjs --test tests/*.test.mjs",
    "test:engine": "node --experimental-loader ./scripts/cloudflare-node-loader.mjs --test tests/atlas-simulation.test.mjs tests/workflow-expansion.test.mjs tests/camera-block-activity.test.mjs tests/safe-automation-controls.test.mjs tests/job-mode-escalation.test.mjs tests/living-world-engine.test.mjs tests/living-world-product.test.mjs tests/webmcp-contract.test.mjs tests/agent-runtime.test.mjs tests/agentic-world-runtime.test.mjs tests/canonical-world-integration.test.mjs tests/agent-message-bridge.test.mjs",
    "test:webmcp": "node --experimental-loader ./scripts/cloudflare-node-loader.mjs --test tests/webmcp-contract.test.mjs tests/agent-message-bridge.test.mjs",
    "test:agent-runtime": "node --experimental-loader ./scripts/cloudflare-node-loader.mjs --test tests/agent-runtime.test.mjs",
    "test:rendered": "node --experimental-loader ./scripts/cloudflare-node-loader.mjs --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "p5": "^2.3.2",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module",
  "displayName": "Asympta World"
}
